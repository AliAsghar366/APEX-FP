{
  "version": 2,
  "public": true,
  "outputDirectory": "site/apexfx.com",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/strapi-proxy" },
    { "source": "/_next/image", "destination": "/api/image" },
    { "source": "/cdn-cgi/:path*", "destination": "/api/cdn-stub" },
    { "source": "/affiliate", "destination": "/affiliate.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/direct-to-sim-live", "destination": "/direct-to-sim-live.html" },
    { "source": "/how", "destination": "/how.html" },
    { "source": "/programs/expert", "destination": "/programs/expert.html" },
    { "source": "/programs/standard", "destination": "/programs/standard.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.mp4",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/assets/(.*)\\.webm",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false
}
